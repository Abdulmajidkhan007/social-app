{
  "expo": {
    "name": "Lumina",
    "slug": "lumina-social",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0A18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lumina.social"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0C0A18"
      },
      "package": "com.lumina.social"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lumina to access your photos",
          "cameraPermission": "Allow Lumina to use your camera"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "lumina"
  }
}
